<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThermalPilot 1.3 — Isı ve Performans" Width="1270" Height="890" MinWidth="1050" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#0B0F17" Foreground="#E8EEF8" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#8D9BB2"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DCE6F6"/><Setter Property="Background" Value="#202B3F"/>
      <Setter Property="BorderBrush" Value="#34445E"/><Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E8EEF8"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#8D9BB2"/><Setter Property="Padding" Value="20,13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,12,16"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#55DEC4"/><Setter Property="Foreground" Value="#55DEC4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#131B29"/><Setter Property="BorderBrush" Value="#243047"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#131B29"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="#131B29"/><Setter Property="AlternatingRowBackground" Value="#172132"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowHeight" Value="37"/>
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1A2638"/><Setter Property="Foreground" Value="#8D9BB2"/><Setter Property="Padding" Value="10,12"/><Setter Property="BorderThickness" Value="0"/></Style></Setter.Value></Setter>
      <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#25433F"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1420"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="BorderBrush" Value="#34445E"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#BCCBDD"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Margin="28,22,28,16" Background="#0B0F17">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal"><Border Width="46" Height="46" CornerRadius="12" Background="#163E3B" Margin="0,0,13,0"><TextBlock Text="ϟ" FontSize="34" Foreground="#55DEC4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="ThermalPilot" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ModeBadge" Text="MOD: WINDOWS / ÜRETİCİ AYARLARI" FontSize="10" Foreground="{StaticResource Muted}" Margin="1,3,0,0"/></StackPanel></StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock x:Name="LiveLabel" Text="●  ÖLÇÜM BAŞLIYOR" Foreground="#55DEC4" VerticalAlignment="Center" Margin="0,0,20,0"/><Button x:Name="ExportButton" Content="Raporu kaydet"/><Button x:Name="RefreshButton" Content="Yenile" Margin="0"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,22,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="İŞLEMCİ SICAKLIĞI" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuTemp" Text="— °C" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock x:Name="CpuTempSub" Text="Sensörler aranıyor…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="32"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="EKRAN KARTI SICAKLIĞI" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GpuTemp" Text="— °C" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock x:Name="GpuTempSub" Text="Sensörler aranıyor…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="32"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="İŞLEMCİ KULLANIMI" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuLoad" Text="— %" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock x:Name="CpuSub" Text="İlk örnek bekleniyor…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="32"/></StackPanel></Border>
      <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="BELLEK KULLANIMI" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="RamLoad" Text="— %" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock x:Name="RamSub" Text="Fiziksel bellek" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="32"/></StackPanel></Border>
    </Grid>
    <TabControl Grid.Row="2" x:Name="Tabs" Margin="0,6,0,0">
      <TabItem Header="Genel bakış">
        <Grid TextElement.Foreground="#E8EEF8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Son 3 dakika" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="CPU %  /  sıcaklık °C" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><Canvas x:Name="Chart" Grid.Row="1" Margin="0,16,0,8" ClipToBounds="True" Background="#0F1723"/><StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="━ CPU %" Foreground="#55DEC4" Margin="0,0,22,0"/><TextBlock Text="━ CPU °C" Foreground="#FFB45E" Margin="0,0,22,0"/><TextBlock Text="━ GPU °C" Foreground="#AC9DFF"/><TextBlock Text="    0–110 ölçeği" Foreground="{StaticResource Muted}"/></StackPanel></Grid></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Durum analizi" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HealthTitle" Text="İlk ölçüm bekleniyor" Foreground="#55DEC4" FontSize="19" Margin="0,16,0,8" TextWrapping="Wrap"/><TextBlock x:Name="HealthText" Text="Kaynak kullanımı ve mevcut sensörler birlikte değerlendirilecek." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="En çok işlemci kullananlar" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid x:Name="TopGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Uygulama" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="85"/><DataGridTextColumn Header="RAM" Binding="{Binding MemoryText}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Şimdi ne yapabilirsin?" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Advice" Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="22" Margin="0,14,0,14"/><Button x:Name="CoolButton" Content="Sessiz / Serin modu" Background="#17473F" BorderBrush="#2D6A5C" HorizontalAlignment="Left"/><TextBlock Text="Daha az güç tüketimi ısıyı azaltabilir; performansı sınırlar. Değişiklik geri alınabilir." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19"/></StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
      <TabItem Header="İşlemler ve nedenler">
        <Grid TextElement.Foreground="#E8EEF8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12"><StackPanel><TextBlock Text="Kaynak tüketimini bul" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="CPU payı toplam işlemci kapasitesine göre hesaplanır. Bir işlemin sıcaklığı ayrı ayrı ölçülemez." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><TextBox x:Name="SearchBox" Width="230" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="İşlem adı veya PID ara"/></Grid>
          <DataGrid Grid.Row="1" x:Name="ProcessGrid"><DataGrid.Columns><DataGridTextColumn Header="İşlem / uygulama" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75"/><DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="90"/><DataGridTextColumn Header="RAM" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="110"/><DataGridTextColumn Header="G/Ç MB/sn *" Binding="{Binding IoText}" SortMemberPath="IoRate" Width="115"/><DataGridTextColumn Header="Yük yorumu" Binding="{Binding Impact}" Width="200"/><DataGridTextColumn Header="Öncelik" Binding="{Binding Priority}" Width="100"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Margin="0,14,0,0"><WrapPanel><Button x:Name="LowerButton" Content="Seçili işlemin önceliğini düşür"/><Button x:Name="CloseButton" Content="Seçili uygulamayı kapat"/><Button x:Name="InspectButton" Content="REA · Dosyayı incele"/><Button x:Name="TaskManagerButton" Content="Görev Yöneticisi"/></WrapPanel><TextBlock Text="* G/Ç; dosya, aygıt ve ağ aktarımını içerebilir. Isıya katkı, CPU yükünden çıkarılan bir olasılıktır." Foreground="{StaticResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Performans modları">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#E8EEF8"><StackPanel>
          <TextBlock Text="İhtiyacına göre bir mod seç." FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Modlar Windows işlemci güç politikasını değiştirir. Seçimin onaydan sonra uygulanır; gerçek hız, fan sesi ve sıcaklık donanıma ve iş yüküne bağlıdır." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <UniformGrid Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Sessiz / Serin" FontSize="19" FontWeight="SemiBold" Foreground="#55DEC4"/><TextBlock Text="Daha az ısı ve güç tüketimi" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><TextBlock Text="CPU üst sınırı: prizde %70, pilde %50.&#10;İşlemci boost politikası kapalı.&#10;Ağır işlerde performans azalabilir." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="22" MinHeight="88"/><Button x:Name="SaverButton" Content="Serin modu uygula" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Dengeli" FontSize="19" FontWeight="SemiBold" Foreground="#AC9DFF"/><TextBlock Text="Günlük kullanım için denge" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><TextBlock Text="CPU üst sınırı: prizde ve pilde %100.&#10;Desteklenen boost politikası açık.&#10;Enerji tasarrufu tercihi orta düzeyde." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="22" MinHeight="88"/><Button x:Name="BalancedButton" Content="Dengeli modu uygula" Margin="0,14,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Performans" FontSize="19" FontWeight="SemiBold" Foreground="#FFB45E"/><TextBlock Text="Daha hızlı tepkiyi tercih eder" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><TextBlock Text="CPU üst sınırı: prizde ve pilde %100.&#10;Prizde daha atak boost tercihi.&#10;Isı, fan sesi ve pil tüketimi artabilir." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="22" MinHeight="88"/><Button x:Name="PerformanceButton" Content="Performans modunu uygula" Margin="0,14,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="ActiveModeLabel" Text="Etkin mod okunuyor…" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PowerLabel" Text="Etkin güç planı okunuyor…" Foreground="{StaticResource Muted}" Margin="0,9,0,12" TextWrapping="Wrap"/><TextBlock Text="ThermalPilot mevcut planını kopyalar ve geçici planda çalışır. Üst sınırlar işlemci performans politikası içindir; gerçek CPU kullanım yüzdesi farklı olabilir. Desteklenmeyen isteğe bağlı ayarlar ayrıca bildirilir." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,14"/><Button x:Name="RestoreButton" Content="Önceki ayarları geri al" Background="#17473F" BorderBrush="#2D6A5C" HorizontalAlignment="Left"/><CheckBox x:Name="AutoRestore" Content="Çıkarken önceki güç planını ve işlem önceliklerini geri al" IsChecked="True" Margin="0,16,0,0"/><TextBlock x:Name="ChangesLabel" Text="Henüz bir ayar değiştirilmedi." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Arka plan yükünü azalt" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="İşlemler sekmesinde sürekli kaynak tüketen uygulamaları inceleyebilirsin. Mod seçimi uygulamaları kapatmaz veya önceliklerini kendiliğinden değiştirmez." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="22" Margin="0,9,0,14"/><WrapPanel><Button x:Name="StartupButton" Content="Başlangıç uygulamalarını aç"/><Button x:Name="StorageButton" Content="Windows depolama ayarları"/></WrapPanel></StackPanel></Border>
          <TextBlock Text="Fan eğrisi, voltaj ve BIOS değiştirilmez. Daha fazla performans veya belirli bir sıcaklık düşüşü garanti edilmez." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Sensörler ve REA">
        <Grid TextElement.Foreground="#E8EEF8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Gerçek sensör verileri" FontSize="19" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,10,0,14"><TextBlock x:Name="SensorStatus" Text="Donanım kaynakları kontrol ediliyor…" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></ScrollViewer><DataGrid x:Name="SensorGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Sensör" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Değer" Binding="{Binding ValueText}" Width="90"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="150"/></DataGrid.Columns></DataGrid></Grid></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="ThermalPilot içinde sensör motoru" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="RuntimeStatus" Text="Gömülü sensör paketi yerelden hazırlanır. GPU için Windows WDDM ve varsa NVIDIA nvidia-smi bağımsız çalışır; internet gerekmez." Foreground="#55DEC4" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,10"/><TextBlock Text="CPU: LibreHardwareMonitorLib. Bu dağıtım mevcut .NET 10 Windows Desktop Runtime ile yerel sensör yardımcısını kullanır. Uygulama açılışta yönetici erişimi ister. CPU için desteklenen donanım ve PawnIO sürücüsü gerekir. Sürücü kurulumu yalnızca isteğinle başlatılır." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="21"/><Button x:Name="SetupSensorsButton" Content="Sensör motorunu hazırla / yeniden dene" HorizontalAlignment="Left" Margin="0,14,0,10"/><Button x:Name="DriverInstallButton" Content="Sensör sürücüsünü kur" HorizontalAlignment="Left" Margin="0,0,0,10"/><Button x:Name="ElevateButton" Content="Yönetici olarak yeniden aç" HorizontalAlignment="Left" Margin="0,0,0,20"/><TextBlock Text="CPU Package ve GPU Core önceliklidir; bellek/hotspot ayrı etiketlenir. Okunamayan, 0 veya eski değerler gösterilmez. Ayrıntılar yerel sensor-latest.json ve sensor-events.jsonl kayıtlarındadır." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,18"/><TextBlock Text="REA ile dosya inceleme" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="morluto/rea deposundan uyarlanan PE okuyucusu seçili işlemin dosya konumunu, SHA-256 özetini, mimarisini ve bölümlerini dosyayı çalıştırmadan inceler." Foreground="#BCCBDD" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,10"/><Button x:Name="AboutButton" Content="Lisanslar ve uygulama bilgisi" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="Status" Text="Başlatılıyor…" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,300,0"/><TextBlock Text="YEREL ÇALIŞIR  ·  TELEMETRİ GÖNDERMEZ" Foreground="#62758F" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
